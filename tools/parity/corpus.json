  {
   "id": "p03-057",
   "text": " \u06cc\u0648\u064b\u06380\u0301\u064a\u0632\\ \u0627\u0634_\u0642: \u0631\u0636\u0624\u00a0\u0634\ufeeda\u0634"
  },
  {
   "id": "p03-058",
   "text": "'0\u0631\u0636\u0627\ufe8d\u062f\u200e\u064b\u062d\u0647\"\u0622\u0634\u062f\u0624\u0623"
