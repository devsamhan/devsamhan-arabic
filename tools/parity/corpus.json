  {
   "id": "p03-062",
   "text": "\u06219\u0642\u063a\u0621\u0626\u0643\u200e\u062a\u200d{\ufeb3\u064b"
  },
  {
   "id": "p03-063",
   "text": "\u0648\u00a0\u0624\u0651\u200e\u0645\u062e\u0670\u064f0\u062d \u064f\u064f\u0637\u0648\u0642\u0627\u0622[\u0626\u0639\u0642\u064a\u063a\u0631/\ufe8d\u0631\u200c"
  },
  {
   "id": "p03-064",
   "text": "\u063aa\u0631@\u0637\u0637\u0621\u0636\u0638]\u0630\u0642\u0647\u06cc\u0631 \u0625\u200c0%\u062d:-_0"
  },
  {
   "id": "p03-065",
   "text": "\u0634\u0649 ,\ufe8d\u0629\u0627&\u0646\n\u200d\u0636[\u0634\u06319\u062bZ\u0623!"
  },
  {
   "id": "p03-066",
   "text": "\u06cc\u064a\u062b\u0644\u0301\u0301=\u0646\ufeed\u0637\u0642=!\u062d\t\u0642\u0623\u0652\u200f\u0628\u0301{\u0648\u062d+\u0635,\u0635\u0629"
  },
  {
   "id": "p03-067",
   "text": "\u0628\u0649\u0645 !\u0621\u062d,\u0639 \u200fZ?\u064d\u062f\u062d\u064f\u00a0,\ufeed"
  },
  {
   "id": "p03-068",
   "text": "/\\"
  },
  {
   "id": "p03-069",
   "text": "\n\u064d\u200c9\u0629\u0625\u0637\u0648\u0642\ufe8d\t\u0635\u0626\u062c#\u06449\u00a0\u062a\u06cc/[\u0649\u0633\u0640 #\u0626\u0639\u0639\u06399,\u0652\u0645"
  },
  {
   "id": "p03-070",
   "text": "?\"\u0638\u0625\u06280\u062a\u064a\u062b\u00a0\u0671\u0624\n\u062f\u06cc\u062a '\u064f}!.\u200c\u0641\u0635\u062a\u064c\u0301"
  },
  {
   "id": "p03-071",
   "text": "\u064e\u0625\u062b\u0671\u064d\u0647%\u062d"
  },
  {
   "id": "p03-072",
   "text": ""
  },
  {
   "id": "p03-073",
   "text": "\u200f@!\u062d\u062f\u0630\u062f\u0647\u0631Z\u0642\u064a[\u0647\u0630"
  },
  {
   "id": "p03-074",
   "text": "\u0628\u0644{\u063a\t\u0637!\u062a\u0652\u064e].\u064c\u0670\u200e\u0635\u062c\u0638\n\u0624\u0652\ufe8d&\u200da\ufeed@\u0638[\u0636\u200d\u0629\u0630"
  },
  {
   "id": "p03-075",
   "text": "\u0634\u064e\u0640\u06cc\u200d\u0647\u0671"
  },
  {
   "id": "p03-076",
   "text": "\u0670\u064d\u0628\u0628.\u0645\u0628\u0625\u0645_\u063a\u0634\u0639\u0640\u0632\u0627-\u0622\ufe8d\u0626ZZ\u200c\ufe8d\u0645\u064e\u0650,\u064e"
  },
  {
   "id": "p03-077",
   "text": "\u0646\u200d\u064e\u0641\u064a_\u062b\u200f\u0671\u062f \u0627]\u0631'\u00a0\u0649[\u200f\u0621\u0633"
  },
  {
   "id": "p03-078",
   "text": "\u0622\u064e\u0621\u0650%\u062a\u0630\u062d\u0633\u0627+\u0622\u0647\u0635\u0671\u0645\u200f\"\u064e[Z\t\ud83d\ude00\n\u0646\u062d\u06480\u0621\u06cc.\"\"\u062c\u064b"
  },
  {
   "id": "p03-079",
   "text": "'&\u0621\u0641\u0621\u0635\u0642#&\u0647\u0642Z"
  },
  {
   "id": "p03-080",
   "text": "\u0650\u062b_"
  },
  {
