  {
   "id": "p03-087",
   "text": "@\u0635#\u062d\ufeb3\u200e\u0645\u062a\\\u064f{\u064f\ud83d\ude00\u0621]\u064c\u0638"
  },
  {
   "id": "p03-088",
   "text": "}\u064a\u0642\u0671{&\u0624\ufe8d\u0640\u0645\u0626\t\u0652\u0651\u0626\u0638'\u064ca\u06cc\u062e\u062c=\u0637\u0623\u0635a\ufeed:\ufeed"
  },
  {
   "id": "p03-089",
   "text": "\ufeed/{\u0628\u0626\\\n\u0624\u0625]\u0647.\u0626\u0626\u0622\u0633\u062b\u0628\u0638\u064b\u06cc\u064c\n\u0647a\u0643\u06360\u06260\u0626\u0626"
  },
  {
   "id": "p03-090",
   "text": "\u063a\u200d0\t\u0628,9'\u064f\u064d"
  },
  {
   "id": "p03-091",
   "text": "\u064b\u0645 \u062c\u06cc\u0630\u200f\u0635\u0638 \u062c\u0622\u200e"
  },
  {
   "id": "p03-092",
   "text": "0%\u0631\u0634\u0637\u00a0\u062d\u00a0\u0670\u0639\u062f\u062a?\ufeb3-]_\u0637\u0642\u0641\u0628#\u0643'\u200c\u062e@\u0301\u064e\u0649\u0639\u0627]\u0648"
  },
  {
   "id": "p03-093",
   "text": "\u0633\u062a \u0640\ufe8d\u0644\u0631\u0649&\u06cc\u0630#\u0623\u0634\u0626\u0670\u0623!\u0642'\u064e%\n\u00a0\ufeed\u0649\\\u0639\u0631\u0644\u00a0\ufe8d\ufeb3&\ufeed_\ud83d\ude00\u0644\u062a"
  },
  {
   "id": "p03-094",
   "text": "&\n\u0628\u0629"
  },
  {
   "id": "p03-095",
   "text": "\u0636\u0639\u0645\u0625\u0634Z\u0648\u0640\u0639"
  },
  {
   "id": "p03-096",
   "text": "+\u0642\u0652Z\u0637\u062a00\u0639\u063a\u0639\u0631Z=\u0627&9'\u0647\u0622\u064d"
  },
  {
   "id": "p03-097",
   "text": "\u064c}\u200d\u06cc-\u0647\u062d\""
  },
  {
   "id": "p03-098",
   "text": "\u200c\u0628\ufeed\u0645\t\u0652+!"
  },
  {
   "id": "p03-099",
   "text": "a\u062a\\"
  },
  {
   "id": "p03-100",
   "text": "\u062e\u200c\u0623=\u0623=a\u0622\u0641%\u062a\u0301 \u0642\t\u062c\u062b}\u06cc\u0634\u0630\u0624\u0627\u0671\u0646:\u0632{\u200d\u0636\u0621\u0631Z"
  },
  {
   "id": "p03-101",
   "text": "\u0628'=\n\u0627a\t\u0301\u062c\",?\u0634"
  },
  {
   "id": "p03-102",
   "text": "\u0635\u06cc\u00a0\t\u062f=\ufe8d=\u0652"
  },
  {
   "id": "p03-103",
   "text": "\u0642\u0650\ufeb3"
  },
  {
   "id": "p03-104",
   "text": "\u0623\u0652\u0632#\u0645\u200f\u0650Z\u062e\u0652[\u062d\u062f\u064e?\u0624\u0670\u0624 9\u064d\u0639\u0645\u0642\u062c\u0671&\u0635\"\u0635?\u00a0\u0645\u0628\u0625\u0621'\u0631"
  },
  {
   "id": "p03-105",
   "text": "\ufeed\u0631[\u0640\u0652\u064f\u0631?\ufe8d=\u0301\u0627\u064d\u0642\u0629@\u064a\u200e\u200d\u064b\u0624\"\u064a!\ufeb3?\u0649\u0638\u0645\u064a\u064d+\u0641"
  },
  {
   "id": "p03-106",
   "text": "\u0642 \u0632\u0624"
  },
  {
   "id": "p03-107",
   "text": "\u062d-\u0627\u0630\u0628\u0624#\u062e\t\u0647\u062d\t}\u0648\u0649\u0651\u0649\u0630\u0628:\u0301\u0641-\u0648 \u0670+\u064b#\u200e"
  },
  {
   "id": "p03-108",
   "text": "\u064b."
  },
  {
   "id": "p03-109",
   "text": "\u0631[\ud83d\ude00\u0647\u062b\u0623\u200f \u0645{\\99\u200f&0\u0650\u0648"
  },
  {
   "id": "p03-110",
   "text": "\u0630\u063a\u0638\u062b&\u200f#\u200f\u0634\u0635{\u0629\u0628\u0633'&\u0629\u0641\u0638\u200c'\u0621\u0633\u0671[\u0649\u0631\u064d\u0635\u0623\u0627 _\u0638\u0301\u062d]&\u0637'"
  },
  {
   "id": "p03-111",
   "text": "\u0635=\u064e\u200f\u0671\u0631\u0670\u0671-\u062e\ufeb3\u0632\u0671\u062b\u062a\u062e"
  },
  {
   "id": "p03-112",
   "text": "\u062b\u0637\u0646"
  },
  {
   "id": "p03-113",
   "text": "\u0642\u0644\ufeb3:\u200d\u0641\u0630\u0643\u0671\ufe8d&0\u0641\u064d \u0632\u0629\u200d\u0631\u0301\ufeb3\u062e\u0645"
  },
  {
   "id": "p03-114",
   "text": "\u064d\u0623\u200c}\ufe8d\u0632\u200f\u0645\u0629'\u0631\u0636\u0631\u0650\u200c\ud83d\ude00\u0627%\u0627+\u0648\u0646Z!\ufeed\u06cc\u0647\u0637/0\u0636\t\u064c\u0637\u062f]"
  },
  {
   "id": "p03-115",
   "text": "#,\u062d\u00a0\ufeed{9\u0636\u0647\u0646\u0638\ufeed0\u0626\u064d\u0651\u064f\u0645\u062f\u0641\u06cc-\u0646\u0643\u0652"
  },
  {
   "id": "p03-116",
   "text": "=\u0643_\u00a0\u0624\u0643%\u0652_\u0647"
  },
  {
   "id": "p03-117",
   "text": "\u200e\u064c\u0638"
  },
  {
   "id": "p03-118",
   "text": "\u0649a"
  },
  {
   "id": "p03-119",
   "text": "\ufeed\u0623\u062c\u0623\u0635\u062f\u064b\n\u064e\u0634\u0629\u0638\u064c\u0642\u064f\u064d\u00a0_\u0641"
  },
  {
   "id": "p03-120",
   "text": "\u0627\u0650\ud83d\ude00+\u0638/-\u062d\ud83d\ude00\u062a"
  },
  {
   "id": "p03-121",
   "text": "&\u0624@\u0628[\u0640\u0301\u062d\u0649\u0635\u0633\u0630\u0645\u0651\u062d"
  },
  {
   "id": "p03-122",
   "text": ".\u062d\u0646\u0624/\u0622\u0627\u0627\u0632\u062d\u0648#\u0644\u0633\u062e\u0634\u0633\u0622\u0633'\u0621{\u062a\u0642.\u0639\u062a\n\t"
  },
  {
   "id": "p03-123",
   "text": "\ufeb3\u0626\u0638\u0622\u0628\u064f\u0632@\u0627[@+\u0626\u0646\u200c\u064a\ufeb3=\u0633\u062c@\u0643\u0630{"
  },
  {
   "id": "p03-124",
   "text": "\ud83d\ude00\u064b\t\u064c\u0651\u06cc\u062f-\u0628\u06cc?Z\u062e\"\u0622\u0649\u0650'\n\u062f/\u064d/\u0651\n\u063a\u0621\u062f\u0648\u0629\u0636"
  },
  {
   "id": "p03-125",
   "text": "Z%\u064e\u0638\n\u064e}\ufeed\u0645\u064c\u0633..\u0631\u0645\u0631\u0628\u00a0\u0670\u0670\u062d\u0636\u0625\u064e\\"
  },
  {
   "id": "p03-126",
   "text": "\u062c\u062d\u0645"
  },
  {
   "id": "p03-127",
   "text": "\u0628"
  },
  {
   "id": "p03-128",
   "text": "\u0652\u0625?\u0645\u064d\u064c\u200f-a\u0641\u0627\u0648\u0628 \u064e\u0627\u0629\u064d\u0626\u0652=_\u0621 \u064f\\Z\u0649\u0623\ufe8d#!\u0628\u0628\u0633\u0670\u0635"
  },
  {
   "id": "p03-129",
   "text": "\u0629??\u0640\u0671a-\u062b\u062a\u062d."
  },
  {
   "id": "p03-130",
   "text": ":\u0623\u200d9\u0650\u0652/a\u0648\u0634 \u0631\u0649a\u00a0Z=,\u064a\u0644\u062d\ud83d\ude00!\u0623}\u062d\u064c \u0638\u200e\u0633Z\u200e"
  },
  {
   "id": "p03-131",
   "text": "\u200f&\u0644}\u0645\u0651,\n\u0627\u0621 #\u06cc\u0628!#a\u064c\u0634%\u0651\t\u0651&\ufeb3\u062e\u0639\u0639\u062a\u0631\ufe8d\u0628"
  },
  {
   "id": "p03-132",
   "text": "\u0635.\u0670\u062c\u0628,\u062d!\ufe8d."
  },
  {
   "id": "p03-133",
   "text": "\u0627\u0629{\u0652\u0645\u0626"
  },
  {
   "id": "p03-134",
   "text": "-- \u064f{\n\u0671["
  },
  {
   "id": "p03-135",
   "text": "\u0645\ufe8d\u0651\u0646\u0642\u0652:\u0641\t\u0632\u062d\u0636\u200f\u0644{\\9_!\t\u0301}"
  },
  {
   "id": "p03-136",
   "text": "\ufeed[{\u0626\u0650\u062d\ufeeda\u00a0#\u0633\u200f\u064a{=\t\u06279\u062d\u0630\u06cc\u0637 \\\u062a\t 9\u062a\u0647\u0636Z\ufe8d \u0631"
  },
  {
   "id": "p03-137",
   "text": "\u0652\\\u0641,\u0645\u062d\u0631\u062b#\u0631\u0641"
  },
  {
   "id": "p03-138",
   "text": "\u0631\u0621=\u200e\u0650\u0648\u0622\u064e\u06cc?9\u0634\u0630\u0635\u064e#:\u0634\ufeed\u0639 \u200d[\"\u06229\u0624\u0637\u064a0\u062b\u0652\u064a\u0635Z\u0652\u0635"
  },
  {
   "id": "p03-139",
   "text": "!\u200f\ufe8d\u06cc"
  },
  {
   "id": "p03-140",
   "text": "\u0631\u0635\u0633[ /\u064f\u0301\u0632"
  },
  {
   "id": "p03-141",
   "text": "-/\u0634\ufe8d\"\u200e \u0646\u0625\u0632\"\u0635\u0632\u062eZ\u064d\ufe8d?\u0632\u0650]\u0642\u0634"
  },
  {
   "id": "p03-142",
   "text": "\\,a\u0647\u0301\t\u0625?\u200e/\u200e\t/=\u0637\u06cc!\u200c=\u0671.\u0650\u0641\u064d\u0625\u0634\u0632\u0628\u0621\u0643\u0644\u064e\u0630'"
  }
