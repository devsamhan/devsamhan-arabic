{
  "meta": {
    "spec_version": 1,
    "description": "Digit normalization — normalizeDigits function",
    "notes": "Tests digit script conversion between Western (0-9), Eastern Arabic (٠-٩ U+0660-U+0669), and Persian (۰-۹ U+06F0-U+06F9). Both targets accept Western, Eastern, and Persian inputs; Persian is a source only and has no output mode. Complements the digits-* cases in normalize.json with in-sentence and full-set cases."
  },
  "cases": [
    {
      "id": "num-001",
      "name": "Full Eastern Arabic digit set to Western",
      "operation": "normalizeDigits",
      "input": "٠١٢٣٤٥٦٧٨٩",
      "options": { "to": "western" },
      "expected": "0123456789"
    },
    {
      "id": "num-002",
      "name": "Full Western digit set to Eastern Arabic",
      "operation": "normalizeDigits",
      "input": "0123456789",
      "options": { "to": "eastern" },
      "expected": "٠١٢٣٤٥٦٧٨٩"
    },
    {
      "id": "num-003",
      "name": "Full Persian digit set to Western",
      "operation": "normalizeDigits",
      "input": "۰۱۲۳۴۵۶۷۸۹",
      "options": { "to": "western" },
      "expected": "0123456789"
    },
    {
      "id": "num-004",
      "name": "Eastern Arabic digits in Arabic sentence to Western",
      "operation": "normalizeDigits",
      "input": "السعر ١٢٥ ريال",
      "options": { "to": "western" },
      "expected": "السعر 125 ريال"
    },
    {
      "id": "num-005",
      "name": "Western digits in Arabic sentence to Eastern",
      "operation": "normalizeDigits",
      "input": "المبلغ 100 دينار",
      "options": { "to": "eastern" },
      "expected": "المبلغ ١٠٠ دينار"
    },
    {
      "id": "num-006",
      "name": "Mixed Eastern and Western digits to Western",
      "operation": "normalizeDigits",
      "input": "١23٤5",
      "options": { "to": "western" },
      "expected": "12345"
    },
    {
      "id": "num-007",
      "name": "Arabic text without digits is unchanged",
      "operation": "normalizeDigits",
      "input": "مرحبا",
      "options": { "to": "western" },
      "expected": "مرحبا"
    },
    {
      "id": "num-008",
      "name": "Decimal number with Eastern Arabic digits to Western",
      "operation": "normalizeDigits",
      "input": "١٢٣.٤٥",
      "options": { "to": "western" },
      "expected": "123.45",
      "notes": "Non-digit chars (.) pass through unchanged"
    },
    {
      "id": "num-009",
      "name": "Zero digit: Eastern Arabic ٠ to Western",
      "operation": "normalizeDigits",
      "input": "٠",
      "options": { "to": "western" },
      "expected": "0"
    },
    {
      "id": "num-010",
      "name": "Zero digit: Western 0 to Eastern Arabic",
      "operation": "normalizeDigits",
      "input": "0",
      "options": { "to": "eastern" },
      "expected": "٠"
    },
    {
      "id": "num-011",
      "name": "Full Persian digit set to Eastern Arabic",
      "operation": "normalizeDigits",
      "input": "۰۱۲۳۴۵۶۷۸۹",
      "options": { "to": "eastern" },
      "expected": "٠١٢٣٤٥٦٧٨٩",
      "notes": "Persian is a supported source for both targets; it is not an output mode."
    },
    {
      "id": "num-012",
      "name": "Persian digits ۱۲۳ to Eastern Arabic",
      "operation": "normalizeDigits",
      "input": "۱۲۳",
      "options": { "to": "eastern" },
      "expected": "١٢٣"
    },
    {
      "id": "num-013",
      "name": "Mixed Persian and Eastern digits to Eastern Arabic",
      "operation": "normalizeDigits",
      "input": "١۲۳",
      "options": { "to": "eastern" },
      "expected": "١٢٣",
      "notes": "U+0661 stays Eastern; U+06F2 and U+0663 become Eastern U+0662/U+0663."
    },
    {
      "id": "num-014",
      "name": "Persian digits in an Arabic sentence to Eastern Arabic",
      "operation": "normalizeDigits",
      "input": "السعر ۱۲۵ ريال",
      "options": { "to": "eastern" },
      "expected": "السعر ١٢٥ ريال"
    },
    {
      "id": "num-015",
      "name": "Eastern Arabic digits to Eastern Arabic are unchanged",
      "operation": "normalizeDigits",
      "input": "١٢٣",
      "options": { "to": "eastern" },
      "expected": "١٢٣"
    },
    {
      "id": "num-016",
      "name": "Mixed Western, Persian and Eastern digits to Eastern Arabic",
      "operation": "normalizeDigits",
      "input": "1۲٣",
      "options": { "to": "eastern" },
      "expected": "١٢٣"
    },
    {
      "id": "num-017",
      "name": "Persian decimal number to Eastern Arabic keeps punctuation",
      "operation": "normalizeDigits",
      "input": "۱۲.۳۴",
      "options": { "to": "eastern" },
      "expected": "١٢.٣٤",
      "notes": "Decimal separator passes through unchanged."
    }
  ]
}
